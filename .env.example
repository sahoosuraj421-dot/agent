# =====================================================================
# Hugging Face LLM Configuration (Intelligent Firewall Classification)
# =====================================================================
# Hugging Face Access Token (Create free token at https://huggingface.co/settings/tokens)
# Both HUGGINGFACE_API_KEY and HF_TOKEN are supported
HUGGINGFACE_API_KEY=hf_your_hugging_face_token_here
HF_TOKEN=hf_your_hugging_face_token_here

# Hugging Face Model ID used for vendor classification
# Default: Qwen/Qwen2.5-72B-Instruct
# Options:
#   - Qwen/Qwen2.5-72B-Instruct (High reasoning accuracy, recommended)
#   - meta-llama/Llama-3.2-3B-Instruct (Ultra-fast inference)
#   - mistralai/Mistral-7B-Instruct-v0.3 (Reliable structured JSON output)
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# =====================================================================
# Firewall Gateway Credentials & Authentication
# =====================================================================
# Default admin password or token for targeted devices
FIREWALL_PASSWORD=your_firewall_password

# Fortinet FortiGate REST API Bearer Token
FORTIGATE_API_TOKEN=your_fortigate_api_token

# Palo Alto Networks PAN-OS XML API Key
PANOS_API_KEY=your_panos_api_key

# Cisco IOS XE RESTCONF Basic Authentication
CISCO_USER=cisco_admin
CISCO_PASS=cisco_secret

# =====================================================================
# Agent & System Settings
# =====================================================================
# Audit API authorization key (protects the /run REST endpoint)
AUDIT_API_KEY=your_audit_api_key

# Set to true to allow safe demo/synthetic config generation when physical devices are offline
FIREWALL_DEMO_MODE=true
